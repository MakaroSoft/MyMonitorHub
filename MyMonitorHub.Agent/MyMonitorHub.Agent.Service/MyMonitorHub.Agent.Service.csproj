<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MyMonitorHub.Agent.Service</AssemblyName>
    <RootNamespace>MyMonitorHub.Agent</RootNamespace>
    <Nullable>enable</Nullable>
    <UserSecretsId>e1a7f3c2-9b4d-4e8a-b6f0-3d2c1a0e5f78</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
	<PackageReference Include="Serilog.Extensions.Hosting" Version="*" />
	<PackageReference Include="Serilog.Settings.Configuration" Version="*" />
    <PackageReference Include="Serilog.Sinks.File" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyMonitorHub.Agent.Core\MyMonitorHub.Agent.Core.csproj" />
    <ProjectReference Include="..\MyMonitorHub.Agent.Plugins\MyMonitorHub.Agent.Plugins.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="version.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
