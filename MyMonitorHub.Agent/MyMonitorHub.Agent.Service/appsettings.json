{
    "version": 2,
    "server": {
        "url": "https://localhost:5443",
        "account-id": 0,
        "device-id": 0,
        "api-key-protected": "",
        "command-port": 6800,
        "reconnect-attempt-minutes": 45,
        "account-name": "",
        "group-name": "",
        "device-name": "",
        "services": [
            {
                "name": "service1"
            }
        ]
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "%PROGRAMDATA%/MyMonitorHub.Agent/monitor-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30
                }
            }
        ]
    },
    "plugins": [
        {
            "title": "Command Watcher",
            "category": {
                "name": ""
            },
            "description": "Watches to make sure the command listener thread is still working",
            "assembly": "MyMonitorHub.Agent.Plugins.dll",
            "class-name": "MyMonitorHub.Agent.Plugins.CommandWatch",
            "hibernate-seconds": 120
        },
        {
            "title": "Disk Monitor",
            "category": {
                "name": "Disk"
            },
            "description": "Monitors Disk Space",
            "assembly": "MyMonitorHub.Agent.Plugins.dll",
            "class-name": "MyMonitorHub.Agent.Plugins.DiskSpaceMonitor",
            "hibernate-seconds": 120,
            "disks": [
                {
                    "display-measure": "GB",
                    "name": "c:",
                    "sub-category": "All",
                    "threshold-mb": 1024
                }
            ]
        },
        {
            "title": "Http Vortex Monitor",
            "category": {
                "name": "HttpVortex"
            },
            "description": "Monitors ADS http and Vortex",
            "debug": false,
            "assembly": "MyMonitorHub.Agent.Plugins.dll",
            "class-name": "MyMonitorHub.Agent.Plugins.HttpVortexMonitor",
            "hibernate-seconds": 120,
            "report-minutes": 10,
            "urls": [
                {
                    "location": "https://yourdomain.com/page",
                    "name": "My page name",
                    "sub-category": "Category1"
                }
            ]
        },
        {
            "title": "Services Monitor",
            "category": {
                "name": "Service"
            },
            "description": "Monitors the services to make sure they are still running",
            "assembly": "MyMonitorHub.Agent.Plugins.dll",
            "class-name": "MyMonitorHub.Agent.Plugins.ServiceMonitor",
            "hibernate-seconds": 120,
            "services": [
                {
                    "name": "service1",
                    "sub-category": "All"
                }
            ]
        },
        {
            "title": "Application Pool Monitor",
            "category": {
                "name": "App Pool"
            },
            "description": "Watches to make sure the IIS application pools are running",
            "assembly": "MyMonitorHub.Agent.Plugins.dll",
            "class-name": "MyMonitorHub.Agent.Plugins.AppPoolMonitor",
            "hibernate-seconds": 120,
            "app-pools": [
                { "name": "DefaultAppPool", "sub-category": "All" }
            ]
        }
    ]
}
