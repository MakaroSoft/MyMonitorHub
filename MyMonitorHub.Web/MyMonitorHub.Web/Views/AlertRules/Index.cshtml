@model List<string>
@{
    ViewBag.Title = "Alert Rules";
    bool canEdit = ViewBag.CanEdit ?? false;
    var saveUrl = Url.Action("Save", "AlertRules");
    var validateUrl = Url.Action("Validate", "AlertRules");
}

@section Styles {
<style>
    .rule-row td {
        vertical-align: middle !important;
    }
    .rule-text {
        font-family: monospace;
        font-size: 0.9em;
        word-break: break-all;
    }
    .rule-error {
        font-size: 0.85em;
        color: #dc3545;
    }
    .syntax-ref code {
        font-size: 0.85em;
    }
    #newRuleInput {
        font-family: monospace;
        font-size: 0.9em;
    }
    #validationFeedback {
        font-size: 0.85em;
        min-height: 1.2em;
    }
</style>
}

@section JavaScripts {
<script>
    var rules = @Json.Serialize(Model);
    var canEdit = @Html.Raw(canEdit.ToString().ToLower());
    var saveUrl = '@saveUrl';
    var validateUrl = '@validateUrl';
    var validateTimer = null;

    function renderRules() {
        var tbody = $('#rulesTableBody');
        tbody.empty();

        if (rules.length === 0) {
            tbody.append('<tr><td colspan="2" class="text-muted fst-italic">No rules defined.</td></tr>');
            return;
        }

        $.each(rules, function (i, rule) {
            var deleteBtn = canEdit
                ? '<button class="btn btn-sm btn-outline-danger btn-delete-rule" data-index="' + i + '">Delete</button>'
                : '';
            tbody.append(
                '<tr class="rule-row">' +
                '<td class="rule-text">' + escapeHtml(rule) + '</td>' +
                '<td style="white-space:nowrap; width:1px;">' + deleteBtn + '</td>' +
                '</tr>'
            );
        });
    }

    function escapeHtml(text) {
        return $('<div>').text(text).html();
    }

    function saveRules() {
        var $btn = $('#btnSave');
        $btn.prop('disabled', true).text('Saving...');
        $.post(saveUrl, { rules: rules.join(';') })
            .done(function (result) {
                if (result.success) {
                    displayMessage('Rules saved successfully.', 'success');
                } else {
                    var msg = result.message || 'Failed to save rules.';
                    if (result.errors && result.errors.length) {
                        msg += '<br>' + result.errors.map(escapeHtml).join('<br>');
                    }
                    displayMessage(msg, 'fail');
                }
            })
            .fail(function () {
                displayMessage('An error occurred while saving rules.', 'fail');
            })
            .always(function () {
                $btn.prop('disabled', false).text('Save Rules');
            });
    }

    function validateRule(rule, callback) {
        if (!rule || !rule.trim()) {
            callback(false, 'Rule cannot be empty.');
            return;
        }
        $.post(validateUrl, { rule: rule })
            .done(function (result) { callback(result.valid, result.error); })
            .fail(function () { callback(false, 'Validation request failed.'); });
    }

    $(document).ready(function () {
        renderRules();

        $(document).on('click', '.btn-delete-rule', function () {
            var idx = parseInt($(this).data('index'), 10);
            rules.splice(idx, 1);
            renderRules();
        });

        $('#newRuleInput').on('input', function () {
            clearTimeout(validateTimer);
            var rule = $(this).val().trim();
            var $feedback = $('#validationFeedback');
            if (!rule) { $feedback.text('').removeClass('text-danger text-success'); return; }
            validateTimer = setTimeout(function () {
                validateRule(rule, function (valid, error) {
                    if (valid) {
                        $feedback.html('<span class="text-success"><i class="bi bi-check-circle-fill"></i> Valid rule</span>');
                    } else {
                        $feedback.html('<span class="text-danger rule-error"><i class="bi bi-x-circle-fill"></i> ' + escapeHtml(error || 'Invalid rule.') + '</span>');
                    }
                });
            }, 500);
        });

        $('#btnAddRule').on('click', function () {
            var rule = $('#newRuleInput').val().trim();
            if (!rule) return;
            validateRule(rule, function (valid, error) {
                if (valid) {
                    rules.push(rule);
                    renderRules();
                    $('#newRuleInput').val('');
                    $('#validationFeedback').text('').removeClass('text-danger text-success');
                } else {
                    $('#validationFeedback').html('<span class="text-danger rule-error"><i class="bi bi-x-circle-fill"></i> ' + escapeHtml(error || 'Invalid rule.') + '</span>');
                }
            });
        });

        $('#btnSave').on('click', saveRules);
    });
</script>
}

<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">Alert Rules</div>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Alert rules determine which users receive alert notifications and under what conditions.
            Each rule targets a specific user and can optionally filter by page, device group, device type, device name, or time range.
        </p>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Rule</th>
                        @if (canEdit)
                        {
                            <th style="width:1px;"></th>
                        }
                    </tr>
                </thead>
                <tbody id="rulesTableBody"></tbody>
            </table>
        </div>

        @if (canEdit)
        {
            <hr />
            <h6>Add Rule</h6>
            <div class="row g-2 align-items-start mb-1">
                <div class="col">
                    <input type="text" id="newRuleInput" class="form-control"
                           placeholder='e.g. user john@example.com gets alerts for page "Server Room"' />
                    <div id="validationFeedback" class="mt-1"></div>
                </div>
                <div class="col-auto">
                    <button id="btnAddRule" class="btn btn-secondary">Add</button>
                </div>
            </div>

            <div class="mt-3">
                <button id="btnSave" class="btn btn-primary">Save Rules</button>
            </div>
        }
    </div>
</div>

<div class="card syntax-ref">
    <div class="card-header">
        <div class="card-title">Rule Syntax Reference</div>
    </div>
    <div class="card-body">
        <p class="mb-2">Rules use the following grammar. Clauses in <code>[brackets]</code> are optional and may be repeated.</p>
        <pre class="bg-light p-3 rounded"><code>user &lt;username&gt; gets alerts
  [for page "&lt;page name&gt;"]
  [for device group "&lt;group name&gt;"]
  [for device type "&lt;type name&gt;"]
  [for device "&lt;device name&gt;"]
  [between &lt;time&gt; and &lt;time&gt;]</code></pre>
        <p class="mb-1">Time formats accepted: <code>9am</code>, <code>9:30am</code>, <code>17:00</code>, <code>9:00pm</code></p>
        <p class="mb-1">Multiple clauses of the same type narrow the match further.</p>
        <p class="mb-0 text-muted"><strong>Examples:</strong></p>
        <ul class="mb-0">
            <li><code>user john@example.com gets alerts</code></li>
            <li><code>user jane@example.com gets alerts for page "Server Room" between 8am and 6pm</code></li>
            <li><code>user bob@example.com gets alerts for device group "Production" for device type "Windows Server"</code></li>
        </ul>
    </div>
</div>
