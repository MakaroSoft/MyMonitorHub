@using MyMonitorHub.Common.WebApi
@using MyMonitorHub.Domain.Models
@model MyMonitorHub.Domain.Service.SrReportService.SrReportModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Title Goes Here</title>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/ms/site.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />


    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <style>
        /*
         * Force-disable all table borders/dividers/inset shadows. Bootstrap's .table
         * applies a 1px bottom border to every cell which most desktop PDF viewers render
         * as a near-invisible hairline, but some email previews (Fastmail in particular)
         * render those hairlines as prominent full-cell borders. Stripping them in CSS
         * means wkhtmltopdf never writes border draw instructions into the PDF, so no
         * viewer can show them.
         */
        table, thead, tbody, tfoot, tr, th, td {
            border: 0 !important;
            border-collapse: collapse !important;
            box-shadow: none !important;
            background-image: none !important;
        }

        .page-header {
            page-break-before: always !important;
        }

        .row-title {
            background-color: lightgray;
        }

        .serviceRequests td {
            white-space: nowrap;
        }

        .wrap {
            white-space: normal !important;
        }

        .margin-indent {
            margin-left: 30px !important;
            margin-right: 30px !important;
        }

        .bs-callout {
            padding: 20px;
            margin: 20px 0;
            border: 1px solid #eee;
            border-left-width: 5px;
            border-radius: 3px;
            page-break-inside: avoid;
        }

        .bs-callout h4 {
            margin-top: 0;
            margin-bottom: 15px;
        }

        .bs-callout p:last-child {
            margin-bottom: 0;
        }

        .bs-callout-info {
            border-left-color: #1b809e;
        }

        .bs-callout-info h4 {
            color: #1b809e;
        }

        .toc {
            font-size: 18pt;
            margin-left: 0;
            padding-left: 0;
        }

        .toc li {
            list-style-type: none;
        }

        .title {
            font-weight: bold;
            text-decoration: underline;
        }

        .column-row-title td:first-of-type
        {
            text-align: right;
            background-colo2r: lightgray;
            padding-right: 20px;
        }

    </style>
</head>
<body>
    <div class="container-fluid">
        <img src="@Url.Content(Model.Logo)" />
        <p>
            This is an automated email notifying you that the following alert was captured by the monitoring System and has now been resolved.
        </p>
        <p>
        <div class="bs-callout bs-callout-info">
            <h4>Service Request</h4>
            <table class="column-row-title table table-sm">
                <tr>
                    <td width="200px">Id</td>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <td>Status</td>
                    <td>@Model.Status</td>
                </tr>
                <tr>
                    <td>Time</td>
                    <td>@Model.Time.ToString("dddd, MMMM dd, yyyy h:mm:ss tt")</td>
                </tr>
                <tr>
                    <td>Customer</td>
                    <td>@Model.DeviceGroup</td>
                </tr>
                <tr>
                    <td>Device</td>
                    <td>@Model.Device</td>
                </tr>
                <tr>
                    <td>Assigned To</td>
                    <td>@Model.AssignedTo</td>
                </tr>
                <tr>
                    <td>Notes</td>
                    <td>@Model.Notes</td>
                </tr>
            </table>
        </div>

        <div class="bs-callout bs-callout-info">
            <h4>Service Request Detail</h4>
            <table class="table table-sm">
                @foreach (var history in Model.History)
                {
                    <tr class="table-active fw-bold">
                        <td colspan="4">
                            @history.Description
                        </td>
                    </tr>
                    foreach (var evnt in history.Events)
                    {
                        <tr>
                            <td>
                                @evnt.ItemName
                            </td>
                            <td>
                                @evnt.ServerReceivedTimeStamp.ToString("MMM dd, yyyy h:mm:ss tt")
                            </td>
                            <td>
                                @evnt.StatusDescription
                            </td>
                            <td width="20px">
                                @if (evnt.Status == (int)EventType.Ok)
                                {
                                    <span class="ms-icon16 ms-icon16-ok" />
                                }
                                @if (evnt.Status == (int)EventType.Fail)
                                {
                                    <span class="ms-icon16 ms-icon16-fail" />
                                }
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
        <div class="bs-callout bs-callout-info">
            <h4>Current Device Status</h4>
            @await Html.PartialAsync("ItemLayout2", (ItemLayoutView)ViewBag.ItemLayoutView)
        </div>
    </div>
</body>
</html>



