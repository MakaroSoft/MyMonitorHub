@{
    ViewBag.Title = "Email Verification";
    ViewBag.SubTitle = "Email Verification";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-sm-9 col-11">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="card-title">Email Verification</div>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size: 3rem; color: #dc3545;">&#10007;</div>
                <h5 class="mb-3">Verification Failed</h5>
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
                <p class="text-muted small mb-4">
                    Please register again to receive a new verification email.
                </p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary">Register Again</a>
            </div>
        </div>
    </div>
</div>
