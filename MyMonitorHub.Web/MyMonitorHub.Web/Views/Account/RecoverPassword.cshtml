@model MyMonitorHub.Domain.Models.RecoverPasswordModel
@{
    ViewBag.Title = "Password Recovery";
    ViewBag.SubTitle = "Password Recovery";
}
@section JavaScripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    @* SpamPreventionScript removed - PoliteCaptcha not supported in .NET 10 *@
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-sm-8 col-11">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="card-title">@ViewBag.SubTitle</div>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <p>Enter your email address and submit the request. If an account exists, a password reset link will be emailed to you.</p>

                    @Html.ValidationSummary(true, "Password Recovery failed with the following:", new { @class = "alert alert-danger mb-3" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter Email Address" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    @if (ViewBag.success)
                    {
                        <div class="alert alert-success">If your email is in our system, we have sent you a password reset link. Please check your inbox.</div>
                    }
                    else
                    {
                        <div class="d-grid">
                            <button class="btn btn-primary" type="submit">Submit Request</button>
                        </div>
                    }
                }
                @* SpamPreventionFields removed - PoliteCaptcha not supported in .NET 10 *@
            </div>
        </div>
    </div>
</div>
