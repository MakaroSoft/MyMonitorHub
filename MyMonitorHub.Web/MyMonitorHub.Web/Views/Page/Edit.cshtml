@using MyMonitorHub.Domain.Security
@model MyMonitorHub.Domain.Models.PageDetailModel
@{
    ViewBag.Title = "Page Maintenance";
    var disable = "";
    if (!Authorizer.Authorize(Permissions.CanEditPageMaint))
    {
        disable = "disabled = 'disabled'";
    }
    bool isNew = Model.PageId == -1;
}

@section styles {
    <link href="~/Content/showLoading.css" rel="stylesheet" />
}

@section JavaScripts {
<script src="~/Scripts/jquery.showLoading.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/knockout-3.5.0.js"></script>
    <script src="~/Scripts/knockout.mapping-latest.js"></script>
    <script>
        var viewModel = ko.mapping.fromJS(@Json.Serialize(Model));
        $(document).ready(function () {
            $("#myModalForm").validate(); @* required so that I can use rules add later *@

            $.validator.addMethod("customrule", function (value, element, param) {
                return this.optional(element) || value === param;
            }, "You must enter {0}");

            ko.applyBindings(viewModel);
            $('#btnSave').click(function () {
                if ($('#mainForm').valid()) {

                    @* format the data into a json string *@
                    var data = ko.toJSON(viewModel);

                    $("#mainBody").showLoading();

                    $.ajax({
                        url: '@Url.Action("Edit", "Page")',
                        type: "POST",
                        data: data,
                        contentType: "application/json; charset=utf-8",
                        cache: false,
                        success: function (result) {
                            if (result.status === "Success") {
                                @if (isNew)
                                {
                                    <text>
                                window.location = "@Url.Action("List","Page")";
                                    </text>
                                }
                                else
                                {
                                    <text>
                                viewModel.title(viewModel.description());
                                    viewModel.pageId(result.pageId);
                                    $("#alertFail").hide();
                                    $("#alertSuccess")
                                        .html(result.response)
                                        .show();
                                    </text>
                                }





                            } else {
                                $("#alertSuccess").hide();
                                $("#alertFail")
                                    .html("Failed. Reason: <strong>" + result.reason + "</strong>")
                                    .show();

                            }
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                            $("#alertSuccess").hide();
                            $("#alertFail")
                                .html("Failed. Reason: <strong>" + thrownError + "</strong>")
                                .show();
                        },
                        complete: function(data) {
                            $("#mainBody").hideLoading();
                        }
                    });
                }
            });
            $('#myModal').on('show.bs.modal', function (event) {
                $(this).find('form')[0].reset();
            });
            $('#myModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var deviceGroupId = button.data('devicegroupid');
                var index = button.data('index');
                var description = button.data('description');

                $("#txtConfirm").rules('add', {
                    required: true,
                    customrule: description
                });
                $("#myModalForm").validate().resetForm();
                $("#modalAlert").hide();
                $('#deviceGroupName').text(description);

                $(this).data("devicegroupid", deviceGroupId);
                $(this).data("rowindex", index);
            });
            $("#btnDelete").click(function () {
                if ($('#myModalForm').valid()) {
                    $("#myModalArea").showLoading();
                    var deviceGroupId = $("#myModal").data("devicegroupid");

                    $.ajax({
                        url: '@Url.Action("Delete", "DeviceGroup")/' + deviceGroupId,
                        type: "POST",
                        contentType: "application/json; charset=utf-8",
                        cache: false,
                        success: function (result) {
                            if (result.status === "Success") {
                                $("#myModal").modal("hide");
                                window.location = "@Url.Action("Edit","Page", new { id = ViewContext.RouteData.Values["id"] })";
                                return;
                            } else {
                                $("#modalAlertFail")
                                    .html("Failed. Reason: <strong>" + result.reason + "</strong>")
                                    .show();
                                $("#modalAlert").show();
                            }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            $("#modalAlertFail")
                                .html("Failed. Reason: <strong>" + thrownError + "</strong>")
                                .show();
                            $("#modalAlert").show();
                        },
                        complete: function (data) {
                            $("#myModalArea").hideLoading();
                        }
                    });


                }
            });

        });
    </script>
}

<div class="card">
    <div class="card-header">
        <div class="card-title">@ViewBag.Title</div>
    </div>
    <div id="mainBody" class="card-body">
        <form id="mainForm">
            <legend class="mb-3">
                <a class="underline" href="@Url.Action("List", "Page")">Page List</a> - <span data-bind="text: title"></span>
            </legend>

            <div class="row mb-2 col-lg-6">
                <label class="col-sm-4 col-form-label text-sm-end" for="Description">Page Name</label>
                <div class="col-sm-8">
                    <input data-bind="value: description" class="form-control" id="Description" name="Description" type="text" @disable required minlength="3" />
                </div>
            </div>
        </form>

        <div class="text-end mt-3">
            <input id="btnSave" class="btn btn-primary" type="button" value="Save" @disable />
            <a href="@Url.Action("Edit", "Page", new {id = ViewContext.RouteData.Values["id"]})" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</div>

<div id="alertSuccess" class="alert alert-success" hidden="hidden"></div>
<div id="alertFail" class="alert alert-danger" hidden="hidden"></div>

@if (Authorizer.Authorize(Permissions.CanViewDeviceGroupMaint) && Model.PageId != -1) {
    <div class="card">
        <div class="card-header">
            @if (Authorizer.Authorize(Permissions.CanEditDeviceGroupMaint))
            {
                <a data-bind="attr: { href: '@Url.Action("Edit", "DeviceGroup", new {id = -1})?PageId='+pageId() }" href="#" class="float-end ms-icon16 ms-icon16-add"></a>
            }
            <div class="card-title">Device Groups</div>
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>Device Group</th>
                    @if (Authorizer.Authorize(Permissions.CanEditDeviceGroupMaint))
                    {
                        <th>Delete</th>
                    }
                </tr>
                </thead>
                <tbody data-bind="foreach: deviceGroups">
                <tr>
                    <td><a class="underline" data-bind="attr: { href: '@Url.Action("Edit", "DeviceGroup")/' + deviceGroupId() }, text: description"></a></td>
                    @if (Authorizer.Authorize(Permissions.CanEditDeviceGroupMaint))
                    {
                        <td>
                            <a href="#" data-bind='attr: { "data-description": description, "data-devicegroupid": deviceGroupId, "data-index": $index }' class="ms-icon16 ms-icon16-fail" data-bs-toggle="modal" data-bs-target="#myModal"></a>
                        </td>
                    }
                </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal -->
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div id="myModalArea" class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h4 class="modal-title" id="myModalLabel">Delete Device Group <strong><span id="deviceGroupName"></span></strong></h4>
            </div>
            <form id="myModalForm">
                <div class="modal-body">
                    <p>
                        Warning, this cannot be undone. Are you sure you want to delete this device group?
                    </p>
                    <div class="form-group">
                        <label for="txtConfirm">Type the device group name as confirmation</label>
                        <input id="txtConfirm" name="txtConfirm" class="form-control" />
                    </div>



                </div>
            </form>

            <div class="modal-footer">
                <button id="btnDelete" type="button" class="btn btn-primary">Delete</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <div id="modalAlert" style="margin-top: 10px; margin-bottom: -20px; text-align: left;" hidden="hidden">
                    <div id="modalAlertFail" class="alert alert-danger" hidden="hidden"></div>
                </div>
            </div>

        </div>
    </div>
</div>