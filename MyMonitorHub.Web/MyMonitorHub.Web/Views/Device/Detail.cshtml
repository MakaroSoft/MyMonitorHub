@using MyMonitorHub.Common.WebApi
@using MyMonitorHub.Domain.Security
@using MyMonitorHub.Domain.Service
@using MyMonitorHub.Web.Html
@model MyMonitorHub.Domain.Models.DeviceLayoutModel
@{
    ViewBag.Title = "Device Detail";
    var canStopStartServices = Authorizer.Authorize(Permissions.CanStopStartServices);

    var isCpuFilter = Context.Request.Query["filter"] == "CPU";
}
@section Styles
{
    <link href="~/Content/showLoading.css" rel="stylesheet" />
<link rel="stylesheet" href="@Url.Content("~/Content/bootstrap-toggle.min.css")" />
    <style>
        .treeView, .treeView ul {
            padding: 0;
            margin: 0;
        }

        .treeView li {
            list-style-type: none;
            padding: 0;
        }

        .treeView li li {
            margin-left: 20px;
        }

        .treeView span {
            cursor: pointer;
            display: inline-block;
        }

        .files th {
            white-space: nowrap;
            padding-left: 10px;
            text-align: left;
        }

        .files td {
            white-space: nowrap;
            padding-left: 10px;
        }

        .columnLength {
            text-align: right;
            padding-right: 10px;
        }
        .treeNode {
            background-color: white;
        }
        .treeNodeSelected {
            background-color: #cce8ff;
            border: 1px solid #8fd1ff;
            padding-left: 2px;
            padding-right: 2px;
        }
    </style>


    <style>
        .ms-notes-area td {
            padding-left: 10px;
            padding-left: 10px;
        }

        .ms-hand {
            cursor: pointer;
        }
        #folderPath {
            margin-bottom: 5px;
            padding-left: 3px;
            padding-right: 3px;
            border: 1px solid gray;
            height: 20px;
        }

        /* Card header: make the group hyperlink black instead of the default link blue. */
        .card-header .card-title a.underline,
        .card-header .card-title a.underline:hover,
        .card-header .card-title a.underline:focus,
        .card-header .card-title a.underline:active {
            color: #000;
        }

        /* Card header: make the device-name dropdown look like plain text instead of a button. */
        .card-header .card-title .device-name-dropdown {
            color: #000;
            background: none;
            border: none;
            padding: 0;
            font-weight: inherit;
            text-decoration: none;
            box-shadow: none;
        }

        .card-header .card-title .device-name-dropdown:hover,
        .card-header .card-title .device-name-dropdown:focus,
        .card-header .card-title .device-name-dropdown:active {
            color: #000;
            background: none;
            border: none;
            box-shadow: none;
            text-decoration: underline;
        }
    </style>








    <style>
        .cpu2 {
            text-align: center;
            float: left;
            width: 90px;
        }

        .cpu {
            height: 70px;
            width: 90px;
        }
        .cpu2Test {
            text-align: center;
            float: left;
            width: 100%;
        }

        .cpuTest {
            height: 400px;
            width: 100%;
        }
    </style>
<link rel="stylesheet" href="@Url.Content("~/Content/jquery.fileupload.css")" />
