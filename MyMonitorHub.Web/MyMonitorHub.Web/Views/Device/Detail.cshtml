    @if (Context.Request.Query["filter"] == "CPU")
    {
        <script type="text/javascript">
            var first2 = true;
            var myCpus2;
            var first2Zoom = true;
            var myCpus2Zoom;
            

            var pInfo = [];
            $(document)
                .ready(function() {


                    $("<div id='tooltip'></div>")
                        .css({
                            position: "absolute",
                            display: "none",
                            border: "1px solid #fdd",
                            padding: "2px",
                            "background-color": "#fee",
                            opacity: 0.80
                        })
                        .appendTo("body");


                    $("#c2pu")
                        .bind("plotselected",
                            function() {

                                //$("#selection").text(ranges.xaxis.from.toFixed(1) + " to " + ranges.xaxis.to.toFixed(1));

                                //$.each(myCpus2.getXAxes(), function(_, axis) {
                                //    var opts = axis.options;
                                //    opts.min = ranges.xaxis.from;
                                //    opts.max = ranges.xaxis.to;
                                //});
                                //myCpus2.setupGrid();
                                //myCpus2.draw();
                                //myCpus2.clearSelection();
                            });

                    $("#zoomChart")
                        .bind("plothover",
                            function(event, pos, item) {

                                if (item) {
                                    var x = item.datapoint[0].toFixed(0),
                                        y = item.datapoint[1].toFixed(0);

                                    var text = pInfo[y][x];


                                    $("#tooltip")
                                        .html(text)
                                        .css({ top: item.pageY + 5, left: item.pageX + 5 })
                                        .fadeIn(200);
                                } else {
                                    $("#tooltip").hide();
                                }
                            });


                    $.plot("#c2pu",
                    [],
                    {
                        series: {
                            shadowSize: 0 // Drawing is faster without shadows
                        },
                        yaxis: {
                            min: 0,
                            max: 100
                        },
                        xaxis: {
                            show: false
                        }
                    });
                    $.plot("#zoomChart",
                    [],
                    {
                        series: {
                            shadowSize: 0 // Drawing is faster without shadows
                        },
                        yaxis: {
                            min: 0,
                            max: 100
                        },
                        xaxis: {
                            show: false
                        }
                    });
                    $('#btnZoom')
                        .click(function(event) {
                            event.preventDefault();
                            drawCpuChartZoomRequest();
                            myCpus2.clearSelection();
                        });
                });

            function drawCpuChartRequest() {
                var itemId = $('#ddlName').val();

                var chartUrl = getDayUrl + "/" + itemId + "?date=" + $("#txtDate").val();
                $('#c2pu').showLoading();

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: chartUrl,
                    dataType: 'json',
                    accept: 'application/json',

                    error: function(xhr, ajaxOptions, thrownError) {
                        $('#c2pu').hideLoading();
                        displayMessage("error", "fail");
                        var message = xhr.status + " - " + thrownError;
                        $("#processing-result")
                            .text(message)
                            .removeClass('')
                            .addClass('alert')
                            .addClass('alert-warning')
                            .show();
                    },
                    success: function(data) {
                        if (data.Status === "Fail") {
                            $('#c2pu').hideLoading();
                            displayMessage(data.Reason, "fail");
                            return;
                        }
                        drawCpuChart(data.Response);
                    }
                });
            }

            function drawCpuChart(entry) {

                var cpus = entry.cpus.length;

                var i = 0;
                var dta = [];
                for (i; i < cpus; i++) {
                    var mydata = entry.cpus[i].Ticks;
                    var res = [];
                    var value = 1390780800000;
                    for (var ii = 0; ii < mydata.length; ii++) {
                        res.push([value + ii, mydata[ii]]);
                        value = value + 5000;
                    }

                    dta[i] = { data: res, label: "cpu" + i };

                }
                //if (first2) {
                myCpus2 = $.plot("#c2pu",
                    dta,
                    {
                        series: {
                            shadowSize: 0, // Drawing is faster without shadows
                            lines: {
                                show: true
                            },
                            points: {
                                show: false
                            }
                        },
                        grid: {
                            hoverable: false,
                            clickable: false
                        },
                        yaxis: {
                            min: 0,
                            max: 100
                        },
                        xaxis: {
                            mode: "time",
                            timeformat: "%I:%M %p", // HH:MM am/pm
                            tickSize: [1, "hour"], // tick every hour
                            twelveHourClock: true,
                            min: 1390780800000, // start of today
                            max: 1390863600000 + 3600000 // end of today
                        },
                        selection: {
                            mode: "x"
                        }
                    });


                //} else
                //{
                //    myCpus2.setData(dta);
                //}
                myCpus2.draw();
                $('#c2pu').hideLoading();

                first2 = false;
            }

            function drawCpuChartZoomRequest() {
                var itemId = $('#ddlName').val();
                var date = $('#txtDate').val();
                var time = $('#ddlTime').val();

                var chartUrl = getHourUrl + "/" + itemId + "?date=" + date + "&hour=" + time;
                $('#zoomChart').showLoading();

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: chartUrl,
                    dataType: 'json',
                    accept: 'application/json',

                    error: function(xhr, ajaxOptions, thrownError) {
                        $('#zoomChart').hideLoading();
                        displayMessage("error", "fail");
                        var message = xhr.status + " - " + thrownError;
                        $("#processing-result")
                            .text(message)
                            .removeClass('')
                            .addClass('alert')
                            .addClass('alert-warning')
                            .show();
                    },
                    success: function(data) {
                        if (data.Status === "Fail") {
                            $('#zoomChart').hideLoading();
                            displayMessage(data.Reason, "fail");
                            return;
                        }
                        drawCpuZoomChart(data.Response);
                    }
                });
            }

            function drawCpuZoomChart(entry) {

                var cpus = entry.cpus.length;

                var i;
                var dta = [];
                for (i = 0; i < cpus; i++) {

                    var mydata = entry.cpus[i].Ticks;
                    var res = [];
                    //var value = 1390780800000;
                    for (var ii = 0; ii < mydata.length; ii++) {
                        res.push([ii, mydata[ii]]);
                        //value = value + 5000;
                    }

                    dta[i] = { data: res, label: "cpu" + i, lines: { show: true }, clickable: false, hoverable: false };

                }
                var processSeries = i;


                pInfo = [];
                for (i = 0; i < 100; i++) {
                    pInfo[i] = [];
                }


                var processInfo = [];
                for (i = 0; i < entry.Processes.length; i++) {
                    var p = entry.Processes[i];
                    processInfo.push([p.X, p.Y]);
                    pInfo[p.Y][p.X] = p.Name;
                }

                dta[processSeries] = {
                    data: processInfo,
                    points: {
                        show: true
                    }
                };


                if (first2Zoom) {
                    myCpus2Zoom = $.plot("#zoomChart",
                        dta,
                        {
                            series: {
                                shadowSize: 0
                            },
                            grid: {
                                hoverable: true,
                                clickable: true,
                                autoHighlight: true
                            },
                            yaxis: {
                                min: 0,
                                max: 100
                            },
                            xaxis: {
                                //mode: "time",
                                //timeformat: "%I:%M %p", // HH:MM am/pm
                                //tickSize: [1, "hour"], // tick every hour
                                //twelveHourClock: true,
                                //min: 1390780800000, // start of today
                                //max: 1390863600000 + 3600000 // end of today
                            
                            }
                        });
                } else {
                    myCpus2Zoom.setData(dta);
                }
                myCpus2Zoom.draw();
                $('#zoomChart').hideLoading();

                first2Zoom = false;
            }

        </script>
    }


}
    <div class="card">
