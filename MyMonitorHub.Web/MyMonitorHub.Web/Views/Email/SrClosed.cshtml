@model MyMonitorHub.Domain.Models.SrClosedView
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <title>Service Request Closed</title>
</head>

<body>
    
    <p>
    This is an automated email notifying you that the following alert was captured by the monitoring system and has now been resolved.<br />
</p>

    <blockquote>
    <table cellpadding="0" cellspacing="0">
        <tr>
            <td>Service Request Id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp; </td>
            <td>@Model.ServiceRequestId</td>
        </tr>
        <tr>
            <td>Status</td>
            <td>@Model.Status</td>
        </tr>
        <tr>
            <td>Time</td>
            <td>@Model.TimeStamp</td>
        </tr>
        <tr>
            <td>Page</td>
            <td>@Model.PageDesc</td>
        </tr>
        <tr>
            <td>Customer</td>
            <td>@Model.GroupDesc</td>
        </tr>
        <tr>
            <td>Device</td>
            <td>@Model.DeviceDesc</td>
        </tr>
        <tr>
            <td>Assigned To</td>
            <td>@Model.UserName&nbsp;</td>
        </tr>
        <tr>
            <td>Notes</td>
            <td>@Model.Notes</td>
        </tr>
    </table>
    </blockquote>
            
    <img alt="" src="@Model.ImageUrl" Height="88"/>
</body>
</html>
