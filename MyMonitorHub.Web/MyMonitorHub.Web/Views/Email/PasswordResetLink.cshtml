@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <title>Reset your MyMonitorHub password</title>
</head>

<body>

    Dear @ViewBag.fullName,<br /><br />

    We received a request to reset the password for your MyMonitorHub account.<br />
    Click the link below to choose a new password. This link will expire in one hour and can only be used once.<br /><br />

    <a href="@ViewBag.link">@ViewBag.link</a><br /><br />

    If you did not request a password reset, you can safely ignore this email &mdash; your password will not be changed.

    <img alt="" src="@ViewBag.imageUrl" Height="88"/>
</body>
</html>
