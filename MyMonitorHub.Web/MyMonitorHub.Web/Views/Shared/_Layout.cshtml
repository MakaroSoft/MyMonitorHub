@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Logging
@inject IDbContextScopeFactory contextScopeFactory
@inject ILoggerFactory loggerFactory
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiforgeryService
@{
    var logo = "~/Content/Organization/MyMonitorHub.png";

    var alertCount = 0;
    if (User.Identity!.IsAuthenticated && Helper.AccountId != 0)
    {
        alertCount = new ServiceRequestService(contextScopeFactory, loggerFactory).GetOutstandingCount();
    }
    var homePage = "";
    if (User.Identity.IsAuthenticated)
    {
        var hp = new UserService(contextScopeFactory).GetHomePage();
        if (hp != null) homePage = hp;
    }
}
@functions {
    IHtmlContent HandleChildren(IList<MyMonitorHub.Domain.Service.TreeNode> children)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var child in children)
        {
            var disabled = !Authorizer.Authorize(Permissions.CanViewPage) ? "disabled" : "";
            var childName = System.Net.WebUtility.HtmlEncode(child.Name);
            sb.Append($"<li id=\"page-{child.PageId}\" class=\"{disabled}\">");
            if (!Authorizer.Authorize(Permissions.CanViewPage))
                sb.Append($"<a href=\"#\" class=\"dropdown-item disabled\">{childName}</a>");
            else
                sb.Append($"<a href=\"{Url.Content($"~/Page/Detail/{child.PageId}")}\" class=\"dropdown-item\">{childName}</a>");
            if (child.ChildNodes?.Count > 0)
            {
                sb.Append("<ul>");
                sb.Append(((HtmlString)HandleChildren(child.ChildNodes)).Value);
                sb.Append("</ul>");
            }
            sb.Append("</li>");
        }
        return new HtmlString(sb.ToString());
    }
}
@{
    MyMonitorHub.Domain.Service.TreeNode? treeNode = null;
    if (User.Identity!.IsAuthenticated)
    {
        if (Helper.AccountId != 0)
        {
            treeNode = new PageService(contextScopeFactory).GetPagesForAccount(Helper.AccountId);
        }
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="@AntiforgeryService.GetAndStoreTokens(Context).RequestToken" />

    <title>@ViewBag.Title</title>

    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css?v=5.3.3" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css?v=1.11.3" rel="stylesheet" />
    <link href="~/Content/ms/site.min.css" rel="stylesheet" />

    @RenderSection("Styles", false)

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js?v=5.3.3"></script>

    <script src="~/Scripts/jquery.linkButton.js" type="text/javascript"></script>
    <script src="~/Scripts/jsrender.js" type="text/javascript"></script>
    <script src="~/Scripts/MakaroSoft.Messages.js?v=4" type="text/javascript"></script>

    @RenderSection("JavaScripts", false)

    <script>
        window.appRoot = "@Url.Content("~/")";
        $.ajaxSetup({
            beforeSend: function (xhr) {
                xhr.setRequestHeader('RequestVerificationToken', $('meta[name="csrf-token"]').attr('content'));
            }
        });
    </script>
</head>
<body>
    <div id="status-message-container" class="col-lg-4 col-12 col-sm-4" style="position: fixed; top: 10px; right: 10px; z-index: 2147483647;">
    </div>
    <div class="container-fluid">
        @if (ViewBag.SuppressHeader == null)
        {
            <div class="row">
                <div class="col-md-12">
                    <a href="@Url.Content("~/")"><img src="@Url.Content(logo)" /></a>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <nav class="navbar navbar-expand-md navbar-light bg-light" role="navigation">
                        <div class="container-fluid">
                            <a class="navbar-brand" href="@Url.Content("~/" + homePage)">Home</a>
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bs-example-navbar-collapse-1" aria-controls="bs-example-navbar-collapse-1" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                                <ul class="navbar-nav me-auto">
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li class="nav-item dropdown">
                                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Devices</a>
                                            <ul class="dropdown-menu">
                                                @if (treeNode != null)
                                                {
                                                    @HandleChildren(treeNode.ChildNodes)
                                                }
                                            </ul>
                                        </li>

                                        <li id="summary" class="nav-item">
                                            <a class="nav-link href="@Url.Content("~/Summary")">
                                                Alerts <span class="badge bg-secondary">@alertCount</span>
                                            </a>
                                        </li>
                                        <li id="search" class="nav-item"><a class="nav-link" href="@Url.Content("~/ServiceRequest/Search")">Search</a></li>

                                        <li class="nav-item dropdown">
                                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Administration</a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="@Url.Content("~/MySettings/Profile")">My Profile</a></li>
                                                <li><hr class="dropdown-divider"></li>

                                                @if (Authorizer.Authorize(Permissions.CanViewAnyone))
                                                {
                                                    <li id="rules"><a class="dropdown-item" href="@Url.Content("~/Settings/Members")">Members</a></li>
                                                }
                                                else
                                                {
                                                    <li id="rules"><a class="dropdown-item disabled" href="#">Members</a></li>
                                                }

                                                @if (Authorizer.Authorize(Permissions.CanViewPageMaint))
                                                {
                                                    <li id="page"><a class="dropdown-item" href="@Url.Content("~/Page/List")">Page Maintenance</a></li>
                                                }
                                                else
                                                {
                                                    <li id="page"><a class="dropdown-item disabled" href="#">Page Maintenance</a></li>
                                                }

                                                @if (Authorizer.Authorize(Permissions.CanViewRoles))
                                                {
                                                    <li id="roles"><a class="dropdown-item" href="@Url.Content("~/Role/Roles")">Roles</a></li>
                                                }
                                                else
                                                {
                                                    <li id="roles"><a class="dropdown-item disabled" href="#">Roles</a></li>
                                                }

                                                @if (Authorizer.Authorize(Permissions.CanViewAlertRules))
                                                {
                                                    <li id="alertrules"><a class="dropdown-item" href="@Url.Content("~/AlertRules/Index")">Alert Rules</a></li>
                                                }
                                                else
                                                {
                                                    <li id="alertrules"><a class="dropdown-item disabled" href="#">Alert Rules</a></li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                </ul>
                                <div class="navbar-nav ms-auto">
                                    @await Html.PartialAsync("_LogOnPartial")
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        }
        @RenderBody()
    </div>
</body>
</html>
