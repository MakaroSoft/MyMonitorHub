@using System.Diagnostics
@using MyMonitorHub.Domain.Security
@using MyMonitorHub.Domain.Models
@using MyMonitorHub.Web.Html
@using MyMonitorHub.Web;

@model MyMonitorHub.Domain.Models.ItemLayoutView
    <table class="table table-sm">
        @{
            const int breakEvery = 5;
            var breakupCount = breakEvery;
        }
        @foreach (var dg in Model.DeviceGroups)
        {
            if (breakupCount == breakEvery)
            {
                breakupCount = 0;
                <tr>
                    <td></td>
                    <td></td>
                    @foreach (var header in Model.Headers)
                    {
                        @* Vertical (bottom-to-top) header. Uses transform:rotate instead of
                           writing-mode because the PDF engine (wkhtmltopdf/old WebKit) ignores
                           writing-mode. The fixed-size wrapper reserves the rotated text's
                           footprint so columns stay narrow and rows don't overlap. The fixed
                           cell width + centered content keeps each header lined up over its
                           status icon below (wkhtmltopdf doesn't reliably equalize auto-width
                           columns between the header row and the data rows). *@
                        <td style="width: 22px; text-align: center; vertical-align: bottom; padding-left: 0; padding-right: 0;">
                            <div style="display: inline-block; position: relative; width: 16px; height: 80px;">
                                @* left offset compensates for rotate-around-left-bottom pushing the
                                   glyphs left of the anchor, so the text centers over the icon below. *@
                                <span style="position: absolute; bottom: 0; left: 14px; white-space: nowrap; -webkit-transform: rotate(-90deg); -webkit-transform-origin: left bottom; transform: rotate(-90deg); transform-origin: left bottom;">@header</span>
                            </div>
                        </td>
                    }

                    <td style="width: 100%;">&nbsp;</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="@(Model.Headers.Count + 3)" style="white-space: nowrap;">&nbsp;</td>
                </tr>
            }
            breakupCount++;

            <tr class="table-active fw-bold">
                <td colspan="@(Model.Headers.Count + 3)" style="white-space: nowrap;">
                    <a name="@dg.DeviceGroupId"></a>
                    @dg.Description
                    @if (Authorizer.Authorize(Permissions.CanViewNotes))
                    {
                        <a href="#" style="float:left;padding-right: 10px;"
                           title="Notes for @dg.Description" class="notes" ajaxdialog="@Url.Action("NotesOnly", "DeviceGroup", new { id = @dg.DeviceGroupId})"><span class="ms-icon16 ms-icon16-notes"></span></a>
                    }
                </td>
            </tr>

            foreach (var device in dg.Devices)
            {
                <tr class="deviceRow" data-id="@device.DeviceId">
                    <td class="indent" style="padding-right: 5px;">
                        
                        @switch (device.Status)
                        {
                            case ItemLayoutViewStatus.Connected:
                                <span class="ms-icon16 ms-icon16-connected connectIcon"></span>
                                break;
                            default:
                                <span class="ms-icon16 ms-icon16-disconnected connectIcon"></span>
                                break;
                        }
                    </td>
                    <td style="white-space: nowrap;">
                        @device.Description
                    </td>

                    @foreach (var code in device.Codes)
                    {
                        <td style="width: 22px; text-align: center;">@Html.Raw(code)</td>
                    }
                    <td style="width: 100%;">&nbsp;</td>
                </tr>
            }
        }
    </table>

