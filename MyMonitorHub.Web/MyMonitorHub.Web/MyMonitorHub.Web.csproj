    <PackageReference Include="Ninject" Version="3.3.6" />
    <PackageReference Include="Ninject.Extensions.DependencyInjection" Version="1.0.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyMonitorHub.DataAccess\MyMonitorHub.DataAccess.csproj" />
    <ProjectReference Include="..\MyMonitorHub.Domain\MyMonitorHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\Repository\" />
  </ItemGroup>
</Project>
