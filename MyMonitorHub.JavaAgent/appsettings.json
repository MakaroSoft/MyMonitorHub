{
    "version": 2,
    "server": {
        "url": "https://localhost:5443",
        "account-id": 0,
        "device-id": 0,
        "api-key": "",
        "refresh-token": "",
        "command-port": 6800,
        "reconnect-attempt-minutes": 45,
        "account-name": "",
        "group-name": "",
        "device-name": "",
        "ssl-trust-all": false,
        "services": [
            {
                "name": "Example",
                "description": "My Example Service",
                "start-command": "SUBMIT commandToStart"
            }
        ]
    },
    "logging": {
        "level": "INFO",
        "file": "monitor-.log",
        "max-history": 30
    },
    "plugins": [
        {
            "title": "Command Watcher",
            "category": {
                "name": ""
            },
            "description": "Watches to make sure the command listener thread is still working",
            "class-name": "mymonitorhub.agent.plugins.CommandWatch",
            "hibernate-seconds": 120
        },
        {
            "title": "Disk Monitor",
            "category": {
                "name": "Disk"
            },
            "description": "Monitors Disk Space",
            "class-name": "mymonitorhub.agent.plugins.VMSDiskSpaceMonitor",
            "hibernate-seconds": 120,
            "disks": [
                {
                    "display-measure": "GB",
                    "name": "C:",
                    "sub-category": "All",
                    "threshold-mb": 1024
                }
            ]
        },
        {
            "title": "Process Monitor",
            "debug": false,
            "category": {
                "name": "Process"
            },
            "description": "Monitors Processes",
            "class-name": "mymonitorhub.agent.plugins.VMSProcessMonitor",
            "hibernate-seconds": 120,
            "report-minutes": 10,
            "processes": [
                { "name": "Example", "sub-category": "Example" }
            ]
        },
        {
            "title": "Error Monitoring",
            "debug": false,
            "description": "Collects the errors on the device",
            "class-name": "mymonitorhub.agent.plugins.ErrorMonitor",
            "sub-categories": [
                {
                    "name": "disk",
                    "includes": [
                        { "name": "*" }
                    ]
                }
            ],
            "hibernate-seconds": 120,
            "report-minutes": 10
        }
    ]
}
